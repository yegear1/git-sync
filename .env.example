# ==============================================================================
# git-sync — Optional Environment Variables Template
# ==============================================================================
# Copy this file to `.env` or set these in your shell profile (~/.bashrc, ~/.zshrc)
# git-sync works out of the box with zero configuration, but supports these overrides:
# ==============================================================================

# Custom workspace root directory containing Git repositories
# Defaults to dynamic discovery: ~/github, ~/Github, ~/src, or current working directory
# GIT_SYNC_ROOT=/home/user/github

# Explicit path to custom configuration file
# Defaults to ~/.git-sync.json or $XDG_CONFIG_HOME/git-sync/config.json
# GIT_SYNC_CONFIG=/home/user/.config/git-sync/config.json

# Standard XDG configuration directory
# XDG_CONFIG_HOME=/home/user/.config

# Optional GitHub personal access token for higher rate-limits during remote checks
# GITHUB_TOKEN=ghp_exampleTokenHere
