# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copie este arquivo para `.env` e preencha com os valores reais do seu ambiente:
# cp .env.example .env
#
# REGRA: NUNCA commite o arquivo `.env` com dados sensíveis no repositório.
# ==============================================================================

# [Serviço A / Aplicação Principal]
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production

# [Banco de Dados / Persistência]
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# [Fila / Cache / Redis]
REDIS_URL=redis://localhost:6379/0

# [Serviços Externos / Integrações]
# EXTERNAL_API_KEY=your_key_here
# EXTERNAL_API_URL=https://api.example.com
